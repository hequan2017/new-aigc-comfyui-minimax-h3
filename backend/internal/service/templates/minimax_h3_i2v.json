{
  "name": "MiniMax H3 图生视频",
  "code": "minimax_h3_i2v",
  "description": "将 1 张起始图像转换为带同步音频的高质量视频片段，适合概念可视化与角色动画测试。",
  "inputs": [
    {"key": "prompt", "type": "prompt", "label": "提示词", "required": false, "help": "可选：描述运动、风格、镜头或声音"},
    {"key": "first_frame", "type": "image", "label": "首帧图片", "required": true},
    {"key": "width", "type": "int", "label": "宽度", "default": 1280, "min": 256, "max": 2560, "step": 32},
    {"key": "height", "type": "int", "label": "高度", "default": 704, "min": 256, "max": 2560, "step": 32},
    {"key": "duration", "type": "float", "label": "时长(秒)", "default": 5, "min": 5, "max": 15},
    {"key": "steps", "type": "int", "label": "采样步数", "default": 20, "min": 1, "max": 100},
    {"key": "seed", "type": "int", "label": "随机种子(-1随机)", "default": -1, "min": -1},
    {"key": "cfg", "type": "float", "label": "CFG", "default": 1.0, "min": 0.5, "max": 8, "step": 0.1},
    {"key": "fps", "type": "int", "label": "输出帧率", "default": 24, "min": 1, "max": 60}
  ],
  "workflow": {
    "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "minimax_h3_fl2va_bf16.safetensors", "weight_dtype": "fp8_e4m3fn"}},
    "2": {"class_type": "MiniMaxH3SigmaShift", "inputs": {"model": ["1", 0], "shift_video": 12.0, "shift_audio": 3.0}},
    "3": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_bf16.safetensors", "type": "minimax"}},
    "4": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}},
    "5": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}},
    "100": {"class_type": "LoadImage", "inputs": {"image": "{{img:first_frame}}"}},
    "101": {"class_type": "LoadImage", "inputs": {"image": "{{img:last_frame}}"}},
    "6": {"class_type": "MiniMaxH3ImageToVideo", "inputs": {
      "clip": ["3", 0], "vae": ["4", 0],
      "prompt": "{{prompt}}",
      "width": "{{width}}", "height": "{{height}}", "length": "{{length}}",
      "first_frame": ["100", 0], "last_frame": ["101", 0]
    }},
    "7": {"class_type": "KSampler", "inputs": {
      "model": ["2", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}",
      "sampler_name": "euler", "scheduler": "simple",
      "positive": ["6", 0], "negative": ["6", 0], "latent_image": ["6", 1], "denoise": 1.0
    }},
    "8": {"class_type": "VAEDecode", "inputs": {"samples": ["7", 0], "vae": ["4", 0]}},
    "9": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["7", 0], "vae": ["5", 0]}},
    "10": {"class_type": "CreateVideo", "inputs": {"images": ["8", 0], "fps": "{{fps}}", "audio": ["9", 0]}},
    "11": {"class_type": "SaveVideo", "inputs": {"video": ["10", 0], "filename_prefix": "minimax/{{task_id}}", "format": "mp4", "codec": "auto"}}
  }
}
