{
  "name": "MiniMax H3 参考视频生成",
  "code": "minimax_h3_ref2v",
  "description": "输入参考图片(0-9)、参考视频(0-3)、参考音频(0-3)，生成风格一致的新视频。提示词中用 <Picture i> / <Video k> / <Audio j> 引用。",
  "inputs": [
    {"key": "prompt", "type": "prompt", "label": "提示词", "required": true, "help": "可用 <Picture 1> <Video 1> <Audio 1> 引用素材"},
    {"key": "ref_images", "type": "images", "label": "参考图片(0-9)", "required": false, "max_count": 9},
    {"key": "ref_videos", "type": "videos", "label": "参考视频(0-3)", "required": false, "max_count": 3},
    {"key": "ref_audios", "type": "audios", "label": "参考音频(0-3)", "required": false, "max_count": 3},
    {"key": "width", "type": "int", "label": "宽度", "default": 1280, "min": 256, "max": 2560, "step": 32},
    {"key": "height", "type": "int", "label": "高度", "default": 704, "min": 256, "max": 2560, "step": 32},
    {"key": "duration", "type": "float", "label": "时长(秒)", "default": 5, "min": 5, "max": 15},
    {"key": "steps", "type": "int", "label": "采样步数", "default": 20, "min": 1, "max": 100},
    {"key": "seed", "type": "int", "label": "随机种子(-1随机)", "default": -1, "min": -1},
    {"key": "cfg", "type": "float", "label": "CFG", "default": 1.0, "min": 0.5, "max": 8, "step": 0.1},
    {"key": "fps", "type": "int", "label": "输出帧率", "default": 24, "min": 1, "max": 60},
    {"key": "ref_image_size", "type": "select", "label": "参考图缩放", "default": "match", "options": ["match", "max"]}
  ],
  "workflow": {
    "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "minimax_h3_ref2va_bf16.safetensors", "weight_dtype": "fp8_e4m3fn"}},
    "2": {"class_type": "MiniMaxH3SigmaShift", "inputs": {"model": ["1", 0], "shift_video": 12.0, "shift_audio": 3.0}},
    "3": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_bf16.safetensors", "type": "minimax"}},
    "4": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}},
    "5": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}},
    "110": {"class_type": "LoadImage", "inputs": {"image": "{{img:ref_image_0}}"}},
    "111": {"class_type": "LoadImage", "inputs": {"image": "{{img:ref_image_1}}"}},
    "112": {"class_type": "LoadImage", "inputs": {"image": "{{img:ref_image_2}}"}},
    "113": {"class_type": "LoadImage", "inputs": {"image": "{{img:ref_image_3}}"}},
    "114": {"class_type": "LoadImage", "inputs": {"image": "{{img:ref_image_4}}"}},
    "115": {"class_type": "LoadImage", "inputs": {"image": "{{img:ref_image_5}}"}},
    "116": {"class_type": "LoadImage", "inputs": {"image": "{{img:ref_image_6}}"}},
    "117": {"class_type": "LoadImage", "inputs": {"image": "{{img:ref_image_7}}"}},
    "118": {"class_type": "LoadImage", "inputs": {"image": "{{img:ref_image_8}}"}},
    "120": {"class_type": "LoadVideo", "inputs": {"file": "{{vid:ref_video_0}}"}},
    "121": {"class_type": "LoadVideo", "inputs": {"file": "{{vid:ref_video_1}}"}},
    "122": {"class_type": "LoadVideo", "inputs": {"file": "{{vid:ref_video_2}}"}},
    "130": {"class_type": "LoadAudio", "inputs": {"audio": "{{aud:ref_audio_0}}"}},
    "131": {"class_type": "LoadAudio", "inputs": {"audio": "{{aud:ref_audio_1}}"}},
    "132": {"class_type": "LoadAudio", "inputs": {"audio": "{{aud:ref_audio_2}}"}},
    "6": {"class_type": "MiniMaxH3ReferenceToVideo", "inputs": {
      "clip": ["3", 0], "vae": ["4", 0], "audio_vae": ["5", 0],
      "prompt": "{{prompt}}",
      "width": "{{width}}", "height": "{{height}}", "length": "{{length}}",
      "ref_image_size": "{{ref_image_size}}",
      "ref_images": {
        "ref_image_0": ["110", 0], "ref_image_1": ["111", 0], "ref_image_2": ["112", 0],
        "ref_image_3": ["113", 0], "ref_image_4": ["114", 0], "ref_image_5": ["115", 0],
        "ref_image_6": ["116", 0], "ref_image_7": ["117", 0], "ref_image_8": ["118", 0]
      },
      "ref_videos": {"ref_video_0": ["120", 0], "ref_video_1": ["121", 0], "ref_video_2": ["122", 0]},
      "ref_audios": {"ref_audio_0": ["130", 0], "ref_audio_1": ["131", 0], "ref_audio_2": ["132", 0]}
    }},
    "7": {"class_type": "KSampler", "inputs": {
      "model": ["2", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}",
      "sampler_name": "euler", "scheduler": "simple",
      "positive": ["6", 0], "negative": ["6", 0], "latent_image": ["6", 1], "denoise": 1.0
    }},
    "8": {"class_type": "VAEDecode", "inputs": {"samples": ["7", 0], "vae": ["4", 0]}},
    "9": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["7", 0], "vae": ["5", 0]}},
    "10": {"class_type": "CreateVideo", "inputs": {"images": ["8", 0], "fps": "{{fps}}", "audio": ["9", 0]}},
    "11": {"class_type": "SaveVideo", "inputs": {"video": ["10", 0], "filename_prefix": "minimax/{{task_id}}", "format": "mp4", "codec": "auto"}}
  }
}
